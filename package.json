{
  "name": "template",
  "private": true,
  "type": "module",
  "imports": {
    "#ics4u-assignment-scripts/*": "./.scripts/*",
    "#ics4u-assignment-scripts/utils": "./.scripts/utils/index.ts"
  },
  "scripts": {
